---
import SectionHead from './SectionHead.astro';
import { useT, visibleTeam, type Lang } from '../i18n';
import { withBase } from '../lib/paths';

interface Props {
  lang: Lang;
  index: string;
}

const t = useT(Astro.props.lang);
const members = visibleTeam(t);
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .map((part) => part[0])
    .slice(0, 2)
    .join('');
---

{
  members.length > 0 && (
    <section class="section team" id="equipa" aria-labelledby="equipa-title">
      <div class="container">
        <SectionHead index={Astro.props.index} eyebrow={t.team.eyebrow} title={t.team.title} intro={t.team.intro} titleId="equipa-title" />

        <ul class="team-grid" role="list">
          {members.map((m, i) => (
            <li class="member reveal" style={`--delay: ${i * 0.1}s`}>
              <div class="frame member-photo">
                {m.photo ? (
                  <img src={withBase(m.photo)} alt={m.name} width="800" height="1000" loading="lazy" decoding="async" />
                ) : (
                  <div class="member-initials" aria-hidden="true">
                    <span>{initials(m.name)}</span>
                  </div>
                )}
                <span class="frame-caption">{m.role}</span>
              </div>
              <div class="member-body">
                {m.placeholder && <span class="placeholder-badge">{t.a11y.placeholder}</span>}
                <h3 class="display member-name">{m.name}</h3>
                <p class="member-role">{m.role}</p>
                <p class="member-bio">{m.bio}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px 32px;
    list-style: none;
    padding: 0;
  }
  .member {
    display: grid;
    gap: 36px;
    align-content: start;
  }
  .member-photo {
    aspect-ratio: 4 / 5;
    padding: 14px 14px 0;
  }
  .member-photo img,
  .member-initials {
    width: 100%;
    height: calc(100% - 24px);
    object-fit: cover;
  }
  .member-photo img {
    filter: grayscale(0.25);
    transition: filter 0.6s var(--ease-out);
  }
  .member:hover .member-photo img {
    filter: none;
  }
  .member-initials {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--mist);
  }
  .member-initials::after {
    content: '';
    position: absolute;
    left: 50%;
    top: -10%;
    width: 1px;
    height: 120%;
    background: var(--rule-strong);
    transform: rotate(34deg);
  }
  .member-initials span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(4rem, 8vw, 6.5rem);
    color: var(--navy);
    opacity: 0.85;
  }
  .member-body {
    display: grid;
    gap: 8px;
    justify-items: start;
  }
  .member-name {
    font-size: clamp(1.75rem, 2.6vw, 2.1rem);
  }
  .member-role {
    font-family: var(--font-label);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .member-bio {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.9875rem;
  }
  @media (max-width: 960px) {
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

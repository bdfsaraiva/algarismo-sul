---
import SectionHead from './SectionHead.astro';
import { useT, visibleTestimonials, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  index: string;
}

const t = useT(Astro.props.lang);
const items = visibleTestimonials(t);
---

{
  items.length > 0 && (
    <section class="section testimonials" id="testemunhos" aria-labelledby="testemunhos-title">
      <div class="container">
        <SectionHead index={Astro.props.index} eyebrow={t.testimonials.eyebrow} title={t.testimonials.title} intro={t.testimonials.intro} titleId="testemunhos-title" />

        <ul class="quotes" role="list">
          {items.map((item, i) => (
            <li class="reveal" style={`--delay: ${i * 0.1}s`}>
              <figure class="quote">
                <span class="quote-mark" aria-hidden="true">
                  “
                </span>
                <blockquote>
                  <p>{item.quote}</p>
                </blockquote>
                <figcaption>
                  {item.placeholder && <span class="placeholder-badge">{t.a11y.placeholder}</span>}
                  <span class="quote-name">{item.name}</span>
                  <span class="quote-role">{item.role}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    list-style: none;
    padding: 0;
  }
  .quotes li:nth-child(2) {
    margin-top: 48px;
  }
  .quote {
    position: relative;
    display: grid;
    gap: 28px;
    height: 100%;
    padding: 40px 32px 32px;
    border-top: 1px solid var(--navy);
  }
  .quote-mark {
    position: absolute;
    top: -6px;
    right: 24px;
    font-family: var(--font-display);
    font-size: 7rem;
    line-height: 1;
    color: var(--navy);
    opacity: 0.12;
  }
  blockquote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.3rem, 1.9vw, 1.55rem);
    font-weight: 500;
    line-height: 1.4;
  }
  figcaption {
    display: grid;
    gap: 4px;
    justify-items: start;
    align-self: end;
  }
  .quote-name {
    font-weight: 600;
  }
  .quote-role {
    font-family: var(--font-label);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .quotes {
      grid-template-columns: 1fr;
    }
    .quotes li:nth-child(2) {
      margin-top: 0;
    }
    .quote {
      padding-inline: 0;
    }
  }
</style>

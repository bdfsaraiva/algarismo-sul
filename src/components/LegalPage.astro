---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang, RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  updated: string;
}

const { lang, route, title, updated } = Astro.props;
---

<BaseLayout lang={lang} route={route} title={title}>
  <article class="legal">
    <div class="container legal-inner">
      <header class="legal-head">
        <p class="eyebrow"><span class="slash" aria-hidden="true">/</span><span>Algarismo Sul</span></p>
        <h1 class="display">{title}</h1>
        <p class="legal-updated">{updated}</p>
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal {
    padding-block: clamp(56px, 8vw, 112px) var(--section-y);
  }
  .legal-inner {
    max-width: calc(780px + 2 * var(--gutter));
  }
  .legal-head {
    display: grid;
    gap: 20px;
    padding-bottom: 40px;
    margin-bottom: 48px;
    border-bottom: 1px solid var(--rule);
  }
  h1 {
    font-size: clamp(2.6rem, 6vw, 4.2rem);
  }
  .legal-updated {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .prose :global(h2) {
    margin: 48px 0 14px;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .prose :global(p),
  .prose :global(ul) {
    margin-bottom: 16px;
    color: var(--muted);
  }
  .prose :global(ul) {
    padding-left: 1.2em;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(strong) {
    color: var(--navy);
  }
  .prose :global(a) {
    color: var(--accent);
  }
</style>

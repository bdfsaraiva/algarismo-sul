---
import { rich, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  index: string;
}

const t = useT(Astro.props.lang);
---

<section class="section section--mist faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <header class="faq-head">
      <p class="eyebrow reveal">
        <span>{Astro.props.index}</span>
        <span class="slash" aria-hidden="true">/</span>
        <span>{t.faq.eyebrow}</span>
      </p>
      <h2 class="display section-title reveal" id="faq-title" style="--delay: .08s" set:html={rich(t.faq.title)} />
      <p class="lede reveal" style="--delay: .16s">{t.faq.intro}</p>
    </header>

    <div class="faq-list reveal" style="--delay: .1s">
      {
        t.faq.items.map((item, i) => (
          <details name="faq" open={i === 0}>
            <summary>
              <span class="faq-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq-q">{item.q}</span>
              <span class="faq-icon" aria-hidden="true" />
            </summary>
            <p class="faq-a" set:html={rich(item.a)} />
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 48px;
    align-items: start;
  }
  .faq-head {
    grid-column: 1 / span 5;
    display: grid;
    gap: 24px;
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }
  .faq-list {
    grid-column: 7 / span 6;
    border-top: 1px solid var(--rule-strong);
  }
  details {
    border-bottom: 1px solid var(--rule-strong);
  }
  summary {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 24px;
    align-items: baseline;
    gap: 12px;
    padding: 24px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
  }
  .faq-q {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    font-weight: 500;
    line-height: 1.3;
  }
  summary:hover .faq-q {
    color: var(--navy-80);
  }
  .faq-icon {
    position: relative;
    width: 16px;
    height: 16px;
    align-self: center;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.35s var(--ease-out);
  }
  .faq-icon::after {
    transform: rotate(90deg);
  }
  details[open] .faq-icon::after {
    transform: rotate(0deg);
  }
  .faq-a {
    padding: 0 36px 28px 52px;
    color: var(--muted);
  }
  details[open] .faq-a {
    animation: open 0.4s var(--ease-out);
  }
  @keyframes open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @media (max-width: 900px) {
    .faq-head,
    .faq-list {
      grid-column: 1 / -1;
    }
    .faq-head {
      position: static;
    }
    .faq-a {
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>

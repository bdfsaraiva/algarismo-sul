---
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';

import displayFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import bodyFont from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieNotice from '../components/CookieNotice.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { NOINDEX, SITE, activeSocials } from '../data/site';
import { routeHref, useT, type Lang, type RouteKey } from '../i18n';
import { withBase } from '../lib/paths';

interface Props {
  lang: Lang;
  route: RouteKey | null;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, route, title, description, noindex = false } = Astro.props;
const t = useT(lang);
const site = Astro.site ?? new URL('http://localhost:4321');

const pageTitle = title ? `${title} · ${SITE.name}` : t.meta.title;
const pageDescription = description ?? t.meta.description;
const abs = (path: string) => new URL(path, site).href;
const canonical = route ? abs(routeHref(route, lang)) : abs(Astro.url.pathname);
const ogImage = abs(withBase('/og-image.png'));
const alternates = route
  ? [
      { hreflang: 'pt-PT', href: abs(routeHref(route, 'pt')) },
      { hreflang: 'en', href: abs(routeHref(route, 'en')) },
      { hreflang: 'x-default', href: abs(routeHref(route, 'pt')) },
    ]
  : [];
const robots = noindex || NOINDEX ? 'noindex' : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: SITE.name,
  url: abs(routeHref('home', 'pt')),
  logo: abs(withBase('/icon-512.png')),
  image: ogImage,
  description: useT('pt').meta.description,
  telephone: SITE.phone.tel,
  email: SITE.email.address,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    postalCode: SITE.address.postalCode,
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  areaServed: SITE.areaServed.map((name) => ({ '@type': 'Place', name })),
  knowsLanguage: ['pt-PT', 'en'],
  sameAs: activeSocials().map((s) => s.url),
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#002250" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Algarismo Sul — Contabilidade" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_GB' : 'pt_PT'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{t.a11y.skip}</a>
    <Header lang={lang} route={route} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFab lang={lang} />
    <CookieNotice lang={lang} />

    <script>
      // Content is only hidden for the reveal effect once this script runs,
      // so a failed or blocked script never leaves sections invisible.
      const targets = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        document.documentElement.classList.add('js');
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 100;
    padding: 12px 20px;
    background: var(--navy);
    color: var(--white);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .skip-link:focus {
    top: 12px;
  }
  main:focus {
    outline: none;
  }
</style>
